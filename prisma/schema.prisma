// Prisma schema — HispaProfe
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PROFESOR
  ADMIN
}

// Niveles MCER para clases particulares, mas el nivel combinado del
// DELE A2/B1 para escolares, que es un examen unico y no un nivel MCER.
enum Nivel {
  A1
  A2
  B1
  B2
  C1
  A2_B1_ESCOLAR
}

// RECORRIDO   = clases particulares
// PREPARACION = preparacion DELE
enum TipoRecorrido {
  RECORRIDO
  PREPARACION
}

enum TipoPaso {
  ACTIVACION
  ACTIVIDAD
  ANDAMIAJE
  MICRO_TAREA
  MACRO_TAREA
}

enum Destreza {
  CO
  CE
  EO
  EE
  EOI
  EEI
}

enum TipoBloque {
  TEXTO
  IMAGEN
  AUDIO
  EMBED
  ENLACE
}

model User {
  // clerkId es opcional a proposito: el profesor puede crear la ficha del
  // estudiante desde una lista de correos antes de que exista la cuenta.
  // Se rellena la primera vez que esa persona entra, emparejando por email.
  id             String   @id @default(cuid())
  clerkId        String?  @unique
  email          String   @unique
  firstName      String?
  lastName       String?
  role           Role     @default(STUDENT)
  nivel          Nivel?
  // Tarifa por hora de este estudiante, en céntimos enteros. Los decimales
  // en coma flotante arrastran errores que al sumar un año se notan.
  tarifaCentimos Int?

  /// Cuándo se le cerró el acceso. Null = entra con normalidad.
  /// Fecha y no booleano: además de saber que está bloqueado, interesa
  /// saber desde cuándo, y una fecha lo dice sin costar nada.
  bloqueadoEl DateTime?

  /// Cuándo se le vació la ficha. Null = la ficha es de una persona real.
  /// Va aparte de bloqueadoEl y no en un estado único porque no son
  /// excluyentes: quien está suprimido está bloqueado por definición.
  suprimidoEl DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  asignacionesRecibidas Asignacion[]   @relation("AsignacionEstudiante")
  asignacionesCreadas   Asignacion[]   @relation("AsignacionProfesor")
  recorridosCreados     Recorrido[]    @relation("AutorRecorrido")
  archivos              Archivo[]      @relation("AutorArchivo")
  gruposCreados         Grupo[]        @relation("ProfesorGrupo")
  membresias            MiembroGrupo[] @relation("EstudianteGrupo")
  ejerciciosCreados     Ejercicio[]    @relation("AutorEjercicio")
  cuentaGoogle          CuentaGoogle?
  clasesImpartidas      Clase[]        @relation("ProfesorClase")
  clasesRecibidas       Clase[]        @relation("EstudianteClase")
  deberes               Deber[]        @relation("EstudianteDeber")
}

model Recorrido {
  id           String        @id @default(cuid())
  titulo       String
  descripcion  String?
  nivel        Nivel
  tipo         TipoRecorrido @default(RECORRIDO)
  orden        Int
  publicado    Boolean       @default(false)
  autor        User?         @relation("AutorRecorrido", fields: [autorId], references: [id])
  autorId      String?
  pasos        Paso[]
  asignaciones Asignacion[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tipo, nivel, orden])
  @@index([autorId])
}

model Paso {
  id          String           @id @default(cuid())
  recorrido   Recorrido        @relation(fields: [recorridoId], references: [id])
  recorridoId String
  orden       Int
  ciclo       Int
  tipo        TipoPaso
  destreza    Destreza?
  titulo      String
  bloques     Bloque[]
  ejercicios  PasoEjercicio[]
  completados PasoCompletado[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Bloque {
  id        String     @id @default(cuid())
  paso      Paso       @relation(fields: [pasoId], references: [id])
  pasoId    String
  orden     Int
  tipo      TipoBloque
  texto     String? // para TEXTO, o descripcion del enlace
  url       String? // para IMAGEN (src) / AUDIO (mp3) / EMBED (iframe) / ENLACE (href)
  etiqueta  String? // descripción de imagen, título del embed/audio o texto del enlace
  imagen    String? // miniatura del enlace (og:image) o del video
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Cohorte. Sirve para asignar a veinticinco personas de una vez.
model Grupo {
  id               String         @id @default(cuid())
  nombre           String
  descripcion      String?
  nivel            Nivel?
  tarifaCentimos   Int?
  profesor         User           @relation("ProfesorGrupo", fields: [profesorId], references: [id])
  profesorId       String
  archivado        Boolean        @default(false)
  miembros         MiembroGrupo[]
  clases           Clase[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  // Vinculo opcional con un curso de Google Classroom. Los grupos de
  // clases particulares se quedan sin vincular y funcionan igual.
  classroomCursoId String?
  classroomNombre  String?
  sincronizadoEl   DateTime?

  @@index([profesorId, archivado])
}

model MiembroGrupo {
  id           String   @id @default(cuid())
  grupo        Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  grupoId      String
  estudiante   User     @relation("EstudianteGrupo", fields: [estudianteId], references: [id], onDelete: Cascade)
  estudianteId String
  createdAt    DateTime @default(now())

  @@unique([grupoId, estudianteId])
  @@index([estudianteId])
}

// El profesor asigna la secuencia entera. No hay seleccion de pasos sueltos:
// para dar menos trabajo se crea una secuencia mas corta.
model Asignacion {
  id           String    @id @default(cuid())
  estudiante   User      @relation("AsignacionEstudiante", fields: [estudianteId], references: [id])
  estudianteId String
  profesor     User      @relation("AsignacionProfesor", fields: [profesorId], references: [id])
  profesorId   String
  recorrido    Recorrido @relation(fields: [recorridoId], references: [id])
  recorridoId  String
  nota         String? // instruccion del profe para este estudiante
  venceEl      DateTime?
  archivada    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  completados PasoCompletado[]

  @@unique([estudianteId, recorridoId])
  @@index([estudianteId, archivada])
  @@index([profesorId])
  @@index([recorridoId, archivada])
}

model PasoCompletado {
  id           String     @id @default(cuid())
  asignacion   Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  asignacionId String
  paso         Paso       @relation(fields: [pasoId], references: [id])
  pasoId       String
  completadoEl DateTime   @default(now())

  // Puntos otorgados por el profesor tras revisar el resultado
  // (Genially, tarea corregida...). El check lo pone el estudiante;
  // los puntos solo el profe. Dos niveles de verificacion.
  puntos       Int?
  verificadoEl DateTime?

  // Lo que respondió el estudiante, con la forma que define cada tipo de
  // ejercicio. Sostiene la corrección al recargar y deja ver al profesor
  // qué contestó, no solo cuánto sacó.
  respuestas   Json?

  @@unique([asignacionId, pasoId])
  @@index([asignacionId])
}

// Imagenes subidas por el profesor. Se guardan en la propia base para no
// depender de ningun servicio externo y para que viajen con la copia de
// seguridad. Se sirven desde /api/archivos/[id].
model Archivo {
  id          String   @id @default(cuid())
  nombre      String
  tipo        String // mime, por ejemplo image/webp
  tamano      Int // en bytes, ya redimensionada
  datos       Bytes
  subidoPor   User?    @relation("AutorArchivo", fields: [subidoPorId], references: [id])
  subidoPorId String?
  createdAt   DateTime @default(now())

  @@index([subidoPorId])
}

enum TipoEjercicio {
  WIDGET
  OPCION_MULTIPLE
  HUECOS
  RELACIONAR
  ORDENAR
}

model Ejercicio {
  id        String          @id @default(cuid())
  tipo      TipoEjercicio
  titulo    String
  nivel     Nivel
  destreza  Destreza?
  etiquetas String[]
  datos     Json
  publicado Boolean         @default(false)
  autor     User?           @relation("AutorEjercicio", fields: [autorId], references: [id])
  autorId   String?
  pasos     PasoEjercicio[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([nivel, destreza])
  @@index([tipo])
  @@index([autorId])
}

model PasoEjercicio {
  id          String    @id @default(cuid())
  paso        Paso      @relation(fields: [pasoId], references: [id], onDelete: Cascade)
  pasoId      String
  ejercicio   Ejercicio @relation(fields: [ejercicioId], references: [id])
  ejercicioId String
  orden       Int

  @@unique([pasoId, ejercicioId])
  @@index([ejercicioId])
}

// Credenciales OAuth del profesor para leer sus cursos de Classroom.
// accessToken y refreshToken se guardan cifrados con AES-256-GCM
// (ver lib/crypto.ts). La clave vive en la variable de entorno
// ENCRYPTION_KEY, nunca en la base de datos.
model CuentaGoogle {
  id           String   @id @default(cuid())
  usuario      User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String   @unique
  email        String?
  accessToken  String
  refreshToken String?
  expiraEl     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// AGENDADA = todavía no ocurrió. DADA = ocurrió y cuenta.
// ANULADA  = se cayó: conserva notas y deberes, pero no cuenta.
enum EstadoClase {
  AGENDADA
  DADA
  ANULADA
}

// La clase en sí. Puede crearse antes de darla (agenda) o después
// (bitácora); la diferencia la marca `estado`, no la forma de nacer.
model Clase {
  id         String @id @default(cuid())
  profesor   User   @relation("ProfesorClase", fields: [profesorId], references: [id])
  profesorId String

  // Destinatario: uno de los dos, nunca los dos ni ninguno. Prisma no sabe
  // expresar esa exclusión, así que la hace cumplir `validarClase`.
  estudiante   User?   @relation("EstudianteClase", fields: [estudianteId], references: [id])
  estudianteId String?
  grupo        Grupo?  @relation(fields: [grupoId], references: [id])
  grupoId      String?

  empiezaEl DateTime
  // Duración y no hora de fin: es lo que hace falta para sumar horas, y
  // evita el caso de la clase que cruza la medianoche.
  minutos   Int
  estado    EstadoClase @default(AGENDADA)

  donde   String? // "en su casa", "aula 2"
  enlace  String? // URL de conexión: Meet automático o pegado a mano
  notas   String? // registro académico. Privado del profesor.
  deberes String? // el texto, uno para toda la clase

  // Foto del precio al marcarla dada, no espejo de la tarifa actual.
  importeCentimos Int?
  cobradaEl       DateTime?

  googleEventoId String? // id del evento espejo en Google Calendar (tanda 2)

  asignados Deber[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profesorId, empiezaEl])
  @@index([estudianteId, empiezaEl])
  @@index([grupoId, empiezaEl])
}

// Los deberes de una clase, uno por estudiante. No guarda el texto: vive en
// `Clase.deberes`. Así corregir una falta no obliga a reescribir seis filas,
// y aun así se puede cerrar el de Ana sin tocar el de Luis.
model Deber {
  id           String    @id @default(cuid())
  clase        Clase     @relation(fields: [claseId], references: [id], onDelete: Cascade)
  claseId      String
  estudiante   User      @relation("EstudianteDeber", fields: [estudianteId], references: [id], onDelete: Cascade)
  estudianteId String
  cerradoEl    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([claseId, estudianteId])
  @@index([estudianteId, cerradoEl])
}
