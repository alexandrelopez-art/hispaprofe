// Prisma schema — HispaProfe
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PROFESOR
  ADMIN
}

enum Nivel {
  A2_B1_ESCOLAR
  B2
}

// RECORRIDO   = secuencia temática (Tiempo libre, Vida sana...)
// PREPARACION = bloque de preparación DELE. Se muestra como "Bloque 1", "Bloque 3"
//               segun el campo `orden`. En schema no se usa la palabra "bloque"
//               porque ya designa los trozos de contenido de un Paso.
enum TipoRecorrido {
  RECORRIDO
  PREPARACION
}

enum TipoPaso {
  ACTIVACION
  ACTIVIDAD
  ANDAMIAJE
  MICRO_TAREA
  MACRO_TAREA
}

enum Destreza {
  CO
  CE
  EO
  EE
  EOI
  EEI
}

enum TipoBloque {
  TEXTO
  IMAGEN
  AUDIO
  EMBED
  ENLACE
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recorrido {
  id          String        @id @default(cuid())
  titulo      String
  descripcion String?
  nivel       Nivel
  tipo        TipoRecorrido @default(RECORRIDO)
  orden       Int
  publicado   Boolean       @default(false)
  pasos       Paso[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tipo, nivel, orden])
}

model Paso {
  id          String    @id @default(cuid())
  recorrido   Recorrido @relation(fields: [recorridoId], references: [id])
  recorridoId String
  orden       Int
  ciclo       Int
  tipo        TipoPaso
  destreza    Destreza?
  titulo      String
  bloques     Bloque[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Bloque {
  id        String     @id @default(cuid())
  paso      Paso       @relation(fields: [pasoId], references: [id])
  pasoId    String
  orden     Int
  tipo      TipoBloque
  texto     String? // para TEXTO
  url       String? // para IMAGEN (src) / AUDIO (mp3) / EMBED (iframe) / ENLACE (href)
  etiqueta  String? // descripción de imagen, título del embed/audio o texto del enlace
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
